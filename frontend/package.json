{
  "name": "xlsx-workflow-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "demo:verify": "vitest run src/tests/connected-flow.test.tsx src/tests/quality-ui.test.tsx src/tests/transformation-ui.test.tsx src/tests/result-ui.test.tsx src/tests/job-polling.test.tsx src/tests/review-report-source.test.ts --reporter=verbose",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "api:generate": "node scripts/generate-api.mjs",
    "api:generate:offline": "node scripts/generate-api.mjs --offline"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.59.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.65.0",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^10.12.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "playwright-core": "^1.64.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
