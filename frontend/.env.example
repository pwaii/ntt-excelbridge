VITE_API_BASE_URL=http://127.0.0.1:8000
# Optional local fallback: local-development (DEV + loopback URLs only).
# Production always requires Cognito; changing this cannot enable a production bypass.
VITE_AUTH_MODE=cognito
# Comma-separated exact HTTPS origins of the configured S3 bucket; no paths.
# Example: https://your-bucket.s3.us-east-1.amazonaws.com
VITE_S3_UPLOAD_ORIGINS=
# Public SPA configuration only. Copy to frontend/.env.local; never add secrets.
# Issuer: https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
VITE_COGNITO_AUTHORITY=
# Hosted UI origin, including https:// (custom Cognito domain is supported).
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
# Existing VITE_COGNITO_APP_CLIENT_ID is accepted as an alias.
VITE_COGNITO_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://127.0.0.1:5173/login
VITE_COGNITO_SCOPES=openid profile email
# REQUIRED for API token retrieval: backend must confirm access or id. No default.
VITE_COGNITO_API_TOKEN_TYPE=
