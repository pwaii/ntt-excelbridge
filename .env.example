# Deployment / runtime config. Copy to .env and fill in. See docs/backend-plan.md (§7).

# Region: MUST be us-east-1. Preflight 2026-10-15 showed this role can only invoke Bedrock
# on-demand in us-east-1 with Amazon Nova. Claude => Marketplace-denied; apac.* profiles => SCP
# deny on ap-southeast-2. See docs/ai-plan.md and memory bedrock-region-model-constraint.
AWS_REGION=us-east-1
ENVIRONMENT=demo

# Amazon Nova (first-party, non-Marketplace, works on-demand in us-east-1).
# Default = lite (most tools). Heavy = pro for the reasoning-heavy tools (#3 formula, #4 standardization).
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_MODEL_ID_HEAVY=amazon.nova-pro-v1:0
BEDROCK_MAX_TOKENS=2048
BEDROCK_TEMPERATURE=0

# Storage / metadata
APP_DATA_BUCKET=
DYNAMO_TABLE=xlsx-workflow
STATE_MACHINE_ARN=

# Auth
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Demo guardrails (§15)
MAX_WORKBOOK_MB=25
MAX_DATA_ROWS=50000
MAX_JOBS_PER_DAY=50
PRESIGNED_URL_TTL_SECONDS=300

# Frontend (Vite — prefix VITE_)
VITE_API_BASE_URL=http://localhost:8000
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
