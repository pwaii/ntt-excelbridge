# Local API/runtime config. Copy this file to .env and fill in only the
# account-specific values. Never commit .env. Deployment receives its values
# from deploy.ps1 parameters and AWS environment variables.

# Bedrock is configured for us-east-1 with first-party Amazon Nova models.
AWS_REGION=us-east-1
# Local development only. Leave empty in deployed Lambda and use its IAM role.
AWS_PROFILE=
ENVIRONMENT=demo

# Amazon Nova (first-party, non-Marketplace, works on-demand in us-east-1).
# Default = lite (most tools). Heavy = pro for the reasoning-heavy tools (#3 formula, #4 standardization).
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_MODEL_ID_HEAVY=amazon.nova-pro-v1:0
BEDROCK_MAX_TOKENS=2048
BEDROCK_TEMPERATURE=0

# Storage / metadata
# Fill these from CloudFormation outputs after deployment. Leave blank before
# the first deployment; Lambda receives the values from infra/template.yaml.
APP_DATA_BUCKET=
S3_PREFIX=jobs
DYNAMO_TABLE=
STATE_MACHINE_ARN=
JOB_TTL_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_API_TOKEN_TYPE=access

# Demo guardrails (§15)
MAX_WORKBOOK_MB=25
MAX_DATA_ROWS=50000
MAX_JOBS_PER_DAY=50
PRESIGNED_URL_TTL_SECONDS=300

# Frontend (Vite — prefix VITE_)
FRONTEND_ORIGIN=http://localhost:5173

# Deployment roles. These roles must already exist; the SAM template does not
# create or modify IAM resources. The caller must be allowed to pass the
# Optional CloudFormation service role. Leave empty to use the authenticated
# deployer's CloudFormation permissions.
CLOUDFORMATION_SERVICE_ROLE_ARN=
# Required Lambda and Step Functions execution roles.
LAMBDA_EXECUTION_ROLE_ARN=
STATE_MACHINE_EXECUTION_ROLE_ARN=
VITE_API_BASE_URL=http://localhost:8000
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
# Hosted UI public settings. Vite reads frontend/.env.local, not this root file.
# USER_POOL_ID alone is insufficient; AUTHORITY is the full Cognito issuer URL.
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://127.0.0.1:5173/login
VITE_COGNITO_SCOPES=openid profile email
# Backend must confirm access or id; no frontend default.
VITE_COGNITO_API_TOKEN_TYPE=
