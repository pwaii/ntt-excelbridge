# Deployment / runtime config. Copy to .env and fill in. See docs/backend-plan.md (§7).

# One region per environment: us-east-1 | ap-southeast-1 | ap-southeast-7
AWS_REGION=us-east-1
ENVIRONMENT=demo

# Resolved at deploy time by infra/scripts/preflight.ps1 — do NOT hardcode a stale ID (§10.1)
BEDROCK_MODEL_ID=
BEDROCK_MAX_TOKENS=2048
BEDROCK_TEMPERATURE=0

# Storage / metadata
APP_DATA_BUCKET=
DYNAMO_TABLE=xlsx-workflow
STATE_MACHINE_ARN=

# Auth
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Demo guardrails (§15)
MAX_WORKBOOK_MB=25
MAX_DATA_ROWS=50000
MAX_JOBS_PER_DAY=50
PRESIGNED_URL_TTL_SECONDS=300

# Frontend (Vite — prefix VITE_)
VITE_API_BASE_URL=http://localhost:8000
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
